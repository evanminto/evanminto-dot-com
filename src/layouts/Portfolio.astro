---
import Default from './Default.astro';
import ProjectCard from '../components/ProjectCard.jsx';

interface Props {
  title: string;
  collectionName: string;
  imgKey: string;
}

// TODO: Use real data
const collections = [];

const { title, collectionName, imgKey } = Astro.props;

const projects = collections[collectionName];
---
<Default>
  <h1>{{ title }}</h1>

  <ul class="l-masonry-horizontal">

    {projects.map((project) => {
      const img = project.data[imgKey] || project.data.img;

      return <li style={`--l-masonry-horizontal__ratio: ${img.width} / ${img.height};`}>
        <ProjectCard title={project.data.title} url={project.page.url} img={img} class="l-masonry-horizontal__content" />
      </li>;
    })}
  </ul>
</Default>