---
import arrow from '../svg/arrow.svg?raw';
import arrowSquiggle from '../svg/arrow-squiggle.svg?raw';

interface Props {
  href: string;
  rel?: string;
  class?: string;
}

const { href, rel, class: className } = Astro.props;
---

<a href={href} class={`cta ${className ?? ''}`} rel={rel}>
  <slot />{' '}
  <span class="cta__icon">
    <Fragment set:html={arrow} />
    <Fragment set:html={arrowSquiggle} />
  </span>
</a>
